# Option A — Environment Variables
# Copy to .env — no changes needed for local testing with Dex.
#
# In Option A the MCP client must be registered as a Native/Public OAuth app
# in your OIDC provider and present its client_id during the PKCE flow.
# There is no client secret — the PKCE code verifier is the proof of identity.
#
# For local testing with Dex, the client_id below is pre-registered in dex-config.yaml.
# For production, register a Native App in your OIDC provider and set the client_id here,
# then configure your MCP client to use it.

# Client ID of the Native/Public OAuth app registered in your OIDC provider.
# This is what you give to MCP client users — no secret required.
MCP_CLIENT_ID=mcp-client
