# Option B — No secrets required — all values are static for local testing.
# Copy to .env (no changes needed).
#
# To use a real OIDC provider instead of Dex, set these in docker-compose.yml:
#   OIDC_CONFIGURATION_URL=https://<your-provider>/.well-known/openid-configuration
#   OIDC_CLIENT_ID=<your-client-id>
#   OIDC_CLIENT_SECRET=<your-client-secret>
#   OIDC_ISSUER_URL=https://<your-provider>

